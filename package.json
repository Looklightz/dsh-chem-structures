{
  "name": "dsh-chem-structures",
  "version": "1.1.1",
  "description": "Draws chemical structures, stereochemistry, reaction equations and electron-pushing mechanisms inside the DSH answer body.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chemistry",
    "smiles",
    "rdkit",
    "molecule",
    "reaction"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "render.cjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.png",
    "vendor/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "private": true
}
